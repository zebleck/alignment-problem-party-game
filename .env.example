# Copy this file to .env and fill in the keys. Never commit .env.

# --- LLM that plays the AI (leave empty to run with the scripted mock AI) ---
ANTHROPIC_API_KEY=
# Model for pitches and token placement
ANTHROPIC_MODEL=claude-sonnet-5-5
# Faster model for live answers during the debate
ANTHROPIC_FAST_MODEL=claude-haiku-5-5

# --- ElevenLabs (leave empty: typed questions only, browser voice on the table screen) ---
ELEVENLABS_API_KEY=
# The AI's voice: copy the Voice ID of any voice in your ElevenLabs account.
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# Optional: a different voice when the table plays in German.
ELEVENLABS_VOICE_ID_DE=
# Optional fine-tuning. Leave empty to use the settings stored with the voice.
#   stability 0-1 (lower = more expressive), similarity 0-1, style 0-1 (higher = more dramatic, slower), speed (1 = normal)
ELEVENLABS_STABILITY=
ELEVENLABS_SIMILARITY=
ELEVENLABS_STYLE=
ELEVENLABS_SPEED=
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_STT_MODEL=scribe_v2

# --- Game ---
PORT=3000
# Starting language for the whole table: en or de (switchable on the moderator console)
GAME_LANGUAGE=en
# Password for the moderator console (/mod?key=...). Empty = a random one is printed at start.
MOD_KEY=
# Questions the AI answers per debate
MAX_QUESTIONS=3
