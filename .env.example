# Copy this file to .env and fill in the keys. Never commit .env.

# --- LLM that plays the AI (leave empty to run with the scripted mock AI) ---
ANTHROPIC_API_KEY=
# Model for pitches and token placement
ANTHROPIC_MODEL=claude-sonnet-5-5
# Faster model for live answers during the debate
ANTHROPIC_FAST_MODEL=claude-haiku-5-5

# --- ElevenLabs (leave empty: typed questions only, browser voice on the table screen) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_STT_MODEL=scribe_v2

# --- Game ---
PORT=3000
# Language the AI speaks: en or de
GAME_LANGUAGE=en
# Password for the moderator console (/mod?key=...). Empty = a random one is printed at start.
MOD_KEY=
# Questions the AI answers per debate
MAX_QUESTIONS=5
